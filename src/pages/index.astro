---
import fs from 'fs';
import path from 'path';
import { parse } from 'yaml';

const articlesDir = path.resolve('./src/content/articles');
const articleFiles = fs.readdirSync(articlesDir).filter((file) => file.endsWith('.md'));
const articles = articleFiles.map((file) => {
  const content = fs.readFileSync(path.join(articlesDir, file), 'utf-8');
  const frontmatter = content.split('---')[1] || '';
  const data = parse(frontmatter);
  return {
    slug: file.replace(/\.md$/, ''),
    title: data.title,
    description: data.description,
    date: data.date,
  };
});

articles.sort((a, b) => new Date(b.date) - new Date(a.date));

const productsPath = path.resolve('./src/data/products.json');
let products = [];
if (fs.existsSync(productsPath)) {
  const productsData = JSON.parse(fs.readFileSync(productsPath, 'utf-8'));
  products = productsData.products;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Secure Home Gadgets | Smart Home Security Reviews</title>
    <meta name="description" content="Editorial home security reviews, buying guides, and product comparisons for smart home security shoppers." />
    <meta property="og:title" content="Secure Home Gadgets" />
    <meta property="og:description" content="Editorial reviews and recommendations for home security devices." />
    <meta property="og:type" content="website" />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f8fafc;
        min-height: 100vh;
        color: #111827;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }
      header {
        text-align: left;
        color: #111827;
        margin-bottom: 3rem;
      }
      header h1 {
        font-size: 3.25rem;
        font-weight: 800;
        margin-bottom: 1rem;
      }
      header p {
        font-size: 1.05rem;
        color: #475569;
        max-width: 700px;
        margin-bottom: 1.5rem;
        line-height: 1.75;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0 2rem;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 2rem;
      }
      .brand a {
        color: #111827;
        font-size: 1.2rem;
        font-weight: 800;
        text-decoration: none;
      }
      .site-nav {
        display: flex;
        gap: 1.25rem;
      }
      .site-nav a {
        color: #475569;
        text-decoration: none;
        font-weight: 600;
      }
      .site-nav a:hover {
        color: #111827;
      }
      .hero {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 2rem;
        background: linear-gradient(135deg, #eef2ff 0%, #ffffff 100%);
        border-radius: 28px;
        padding: 3rem;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
        margin-bottom: 2rem;
      }
      .hero-copy h1 {
        font-size: clamp(2.8rem, 4vw, 4.2rem);
        line-height: 1.05;
        margin-bottom: 1rem;
      }
      .hero-copy p {
        color: #334155;
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 640px;
      }
      .hero-stats {
        display: grid;
        gap: 1rem;
        margin-top: 2rem;
      }
      .stat-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 1.5rem;
        display: grid;
        gap: 0.5rem;
      }
      .stat-card strong {
        font-size: 2rem;
        display: block;
        color: #111827;
      }
      .stat-card span {
        color: #475569;
        line-height: 1.5;
      }
      .feature-list {
        display: grid;
        gap: 1rem;
        margin-top: 2rem;
      }
      .feature-list li {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        list-style: none;
        color: #334155;
        line-height: 1.7;
      }
      .feature-list li strong {
        display: block;
        margin-bottom: 0.5rem;
        color: #111827;
      }
      .section-intro {
        color: #334155;
        margin-bottom: 1rem;
        line-height: 1.75;
      }
      .product-card {
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 1.85rem;
        background: white;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }
      .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
      }
      .product-card h3 {
        color: #111827;
        margin: 0;
        font-size: 1.3rem;
      }
      .product-card p {
        color: #475569;
        line-height: 1.7;
        margin: 0;
      }
      .product-card .meta {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        color: #6b7280;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .product-card .price {
        color: #4f46e5;
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0.5rem 0 1rem;
      }
      .product-card a {
        flex: 1;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 0.85rem 1.25rem;
        background: #667eea;
        color: white;
        text-decoration: none;
        border-radius: 999px;
        font-size: 0.95rem;
        font-weight: 700;
        transition: background 0.2s ease, transform 0.2s ease;
      }
      .product-card a:hover {
        background: #4338ca;
        transform: translateY(-1px);
      }
      .articles-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      }
      article {
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 1.75rem;
        background: white;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }
      article:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
      }
      article h3 {
        color: #111827;
        margin-bottom: 0.75rem;
        font-size: 1.35rem;
      }
      article p {
        color: #475569;
        line-height: 1.75;
        margin-bottom: 1rem;
      }
      .date {
        color: #6b7280;
        font-size: 0.95rem;
      }
      footer {
        text-align: center;
        color: #475569;
        padding: 2rem 0 1rem;
        margin-top: 3rem;
        border-top: 1px solid #e5e7eb;
      }

    </style>
  </head>
  <body>
    <main>
      <header class="site-header">
        <div class="brand"><a href="/">Secure Home Gadgets</a></div>
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/blog">Reviews</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Trusted reviews for safer homes</p>
          <h1>Smart home security buying advice that feels human, not automated.</h1>
          <p class="hero-description">We evaluate smart cameras, video doorbells, door locks, and sensors with real buying guidance, clear comparisons, and straightforward affiliate recommendations.</p>
          <div class="cta-buttons">
            <a href="/blog" class="btn btn-primary">Browse reviews</a>
            <a href="/products" class="btn btn-secondary">Shop recommended products</a>
          </div>
        </div>
        <div class="hero-stats">
          <div class="stat-card">
            <strong>{articles.length}</strong>
            <span>Published reviews and guides</span>
          </div>
          <div class="stat-card">
            <strong>{products.length}</strong>
            <span>Top recommended products</span>
          </div>
          <div class="stat-card">
            <strong>Expert-led</strong>
            <span>Buying advice based on real product research</span>
          </div>
        </div>
      </section>

      <section>
        <h2>Why shoppers trust Secure Home Gadgets</h2>
        <p class="section-intro">We focus on value, reliability, and real-world security performance so buyers can choose the right product without guesswork.</p>
        <ul class="feature-list">
          <li><strong>Independent product selection</strong> — We highlight devices that earn consistent reliability ratings and strong customer satisfaction.</li>
          <li><strong>Clear buying guidance</strong> — The best option for an apartment is not the same as the right system for a large house.</li>
          <li><strong>Value-driven recommendations</strong> — We only link to products with strong performance, supported features, and the most compelling price points.</li>
        </ul>
      </section>

      <!-- Featured Products -->
      {products.length > 0 && (
        <section>
          <h2>🎯 Featured Products</h2>
          <div class="products-grid">
            {products.map((product) => (
              <div class="product-card">
                <h3>{product.name}</h3>
                {product.trending && <div style="color:#ff5a5f;font-weight:700;margin-bottom:0.5rem;">Trending Now</div>}
                <div class="meta">{product.category}</div>
                <p>{product.description}</p>
                <div class="price">{product.price}</div>
                <a href={product.amazon} target="_blank" rel="noopener noreferrer">🛒 Amazon</a>
                <a href={product.bestbuy} target="_blank" rel="noopener noreferrer">Best Buy</a>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Latest Articles -->
      <section id="articles">
        <h2>📚 Latest Reviews & Guides</h2>
        {articles.length > 0 ? (
          <div class="articles-grid">
            {articles.map((article) => (
              <article>
                <a href={`/blog/${article.slug}`}>
                  <h3>{article.title}</h3>
                </a>
                <p>{article.description}</p>
                <p class="date">{article.date}</p>
              </article>
            ))}
          </div>
        ) : (
          <p>Check back soon for reviews and guides.</p>
        )}
      </section>

      <footer>
        <p>&copy; 2026 Secure Home Gadgets. All rights reserved.</p>
        <p>Affiliate disclosure: We may earn a commission from qualifying purchases.</p>
      </footer>
    </main>
  </body>
</html>

