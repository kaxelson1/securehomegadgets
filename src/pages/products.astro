---
import fs from 'fs';
import path from 'path';

const productsPath = path.resolve('./src/data/products.json');
let products = [];
if (fs.existsSync(productsPath)) {
  const productsData = JSON.parse(fs.readFileSync(productsPath, 'utf-8'));
  products = productsData.products;
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recommended Home Security Products | Secure Home Gadgets</title>
    <meta name="description" content="Our top-rated smart home security products with affiliate links to Amazon and Best Buy." />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f8fafc;
        min-height: 100vh;
        color: #111827;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }
      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0 2rem;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 2rem;
      }
      .brand a {
        color: #111827;
        font-size: 1.2rem;
        font-weight: 800;
        text-decoration: none;
      }
      .site-nav {
        display: flex;
        gap: 1.25rem;
      }
      .site-nav a {
        color: #475569;
        text-decoration: none;
        font-weight: 600;
      }
      .site-nav a:hover {
        color: #111827;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75rem 1.25rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        transition: all 0.2s ease;
      }
      .btn-secondary {
        background: #eef2ff;
        color: #1f2937;
        border: 1px solid #c7d2fe;
      }
      .btn-secondary:hover {
        background: #e0e7ff;
        transform: translateY(-1px);
      }
      header {
        text-align: left;
        color: #111827;
        margin-bottom: 2.5rem;
      }
      header h1 {
        font-size: 2.85rem;
        margin-bottom: 0.75rem;
      }
      header p {
        color: #475569;
        max-width: 720px;
        line-height: 1.75;
        margin: 0 auto;
      }
      header a {
        color: #4f46e5;
        text-decoration: none;
        font-size: 1rem;
      }
      header a:hover {
        text-decoration: underline;
      }

      section {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
      }
      section h2 {
        color: #111827;
        border-bottom: 3px solid #c7d2fe;
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
      }

      .products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
      }
      .product {
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 1.75rem;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
      }
      .product:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
      }
      .product h3 {
        color: #111827;
        margin-bottom: 0.75rem;
      }
      .product p {
        color: #475569;
        line-height: 1.7;
        margin-bottom: 1rem;
      }
      .meta {
        color: #6b7280;
        font-size: 0.95rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
      }
      .price {
        font-size: 1.5rem;
        color: #4f46e5;
        font-weight: 700;
        margin: 1rem 0;
      }
      .links {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
      }
      .links a {
        flex: 1;
        padding: 0.85rem;
        background: #4f46e5;
        color: white;
        text-decoration: none;
        border-radius: 999px;
        text-align: center;
        font-weight: 700;
        transition: all 0.2s;
      }
      .links a:hover {
        background: #4338ca;
        transform: translateY(-1px);
      }
      .disclosure {
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        border-radius: 20px;
        padding: 1.75rem;
      }
      .disclosure p {
        margin: 0;
        color: #334155;
        line-height: 1.75;
      }
      .hero {
        background: #eef2ff;
        border-radius: 24px;
        padding: 2rem;
        margin-bottom: 2rem;
        border: 1px solid #dbeafe;
      }
      .hero h1 {
        margin: 0 0 1rem;
        font-size: 2.75rem;
        line-height: 1.05;
      }
      .hero p {
        margin: 0;
        color: #334155;
        line-height: 1.75;
        max-width: 720px;
      }
      footer {
        text-align: center;
        color: #475569;
        padding: 2rem;
      }
    </style>
  </head>
  <body>
    <main>
      <header class="site-header">
        <div class="brand"><a href="/">Secure Home Gadgets</a></div>
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/blog">Reviews</a>
        </nav>
      </header>
      <section class="hero">
        <div>
          <h1>Recommended home security products with honest review context</h1>
          <p>These recommended cameras, doorbells, and smart locks have been selected for reliability, ease of setup, and real-world value.</p>
          <a href="/blog" class="btn btn-secondary" style="margin-top:1.5rem; display:inline-block;">Read our reviews</a>
        </div>
      </section>
      <section>
        <h2>Smart Home Security Products</h2>
        <div class="products-grid">
          {products.length > 0 ? (
            products.map((product) => (
              <div class="product">
                <h3>{product.name}</h3>
                {product.trending && <div style="color:#ff5a5f;font-weight:700;margin-bottom:0.5rem;">Trending</div>}
                <div class="meta">{product.category}</div>
                <p>{product.description}</p>
                <div class="price">{product.price}</div>
                <div class="links">
                  <a href={product.amazon} target="_blank" rel="noopener noreferrer">Amazon</a>
                  <a href={product.bestbuy} target="_blank" rel="noopener noreferrer">Best Buy</a>
                </div>
              </div>
            ))
          ) : (
            <p>Products database is being populated. Check back soon!</p>
          )}
        </div>
      </section>

      <section class="disclosure">
        <h2>📝 Affiliate Disclosure</h2>
        <p>
          Secure Home Gadgets is a participant in the Amazon Associates Program, Best Buy Affiliate Program, and other affiliate networks. We may earn a commission when you click our links and make a purchase. This does not affect the price you pay, and helps us continue creating helpful content.
        </p>
      </section>

      <footer>
        <p>&copy; 2026 Secure Home Gadgets</p>
      </footer>
    </main>
  </body>
</html>
