---
import fs from 'fs';
import path from 'path';
import { parse } from 'yaml';
import { marked } from 'marked';

export async function getStaticPaths() {
  const articlesDir = path.resolve('./src/content/articles');
  const articleFiles = fs.readdirSync(articlesDir).filter((file) => file.endsWith('.md'));
  return articleFiles.map((file) => ({
    params: { slug: file.replace(/\.md$/, '') },
  }));
}

const { slug } = Astro.params;
const articlesDir = path.resolve('./src/content/articles');
const articlePath = path.join(articlesDir, `${slug}.md`);

if (!fs.existsSync(articlePath)) {
  throw new Error(`Article not found: ${slug}`);
}

const content = fs.readFileSync(articlePath, 'utf-8');
const [, frontmatter, body] = content.split('---');
const data = parse(frontmatter);
const html = marked(body.trim());
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.title}</title>
    <meta name="description" content={data.description} />
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: #f8fafc; color: #111827; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      main { max-width: 860px; margin: 0 auto; padding: 2.5rem 1.5rem; }
      .site-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0 2rem; border-bottom: 1px solid #e5e7eb; margin-bottom: 2rem; }
      .brand a { color: #111827; font-size: 1.2rem; font-weight: 800; text-decoration: none; }
      .site-nav { display: flex; gap: 1.25rem; }
      .site-nav a { color: #475569; text-decoration: none; font-weight: 600; }
      .site-nav a:hover { color: #111827; }
      .article-shell { background: white; border: 1px solid #e5e7eb; border-radius: 24px; overflow: hidden; box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08); }
      .article-header { padding: 2rem; border-bottom: 1px solid #e5e7eb; }
      .article-header h1 { margin: 0 0 1rem; font-size: 2.6rem; line-height: 1.05; color: #111827; }
      .meta { display: flex; flex-wrap: wrap; gap: 1rem; color: #6b7280; font-size: 0.95rem; }
      .summary { color: #475569; font-size: 1.05rem; line-height: 1.8; margin-top: 1rem; }
      .article-body { padding: 2rem; color: #334155; line-height: 1.85; }
      .article-body h2 { color: #111827; margin-top: 2rem; margin-bottom: 1rem; font-size: 1.8rem; }
      .article-body h3 { color: #111827; margin-top: 1.75rem; margin-bottom: 0.8rem; font-size: 1.35rem; }
      .article-body p { margin-bottom: 1.2rem; }
      .article-body ul { margin: 1.2rem 0 1.5rem 1.4rem; }
      .article-body li { margin-bottom: 0.85rem; }
      .back-link { display: inline-block; margin: 1.75rem 0 0; color: #4f46e5; text-decoration: none; font-weight: 700; }
      .back-link:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <main>
      <header class="site-header">
        <div class="brand"><a href="/">Secure Home Gadgets</a></div>
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/blog">Reviews</a>
        </nav>
      </header>
      <div class="article-shell">
        <header class="article-header">
          <div class="meta">
            <span>{data.date}</span>
            {data.author && <span>{data.author}</span>}
            {data.tags && <span>{data.tags}</span>}
          </div>
          <h1>{data.title}</h1>
          <p class="summary">{data.description}</p>
        </header>
        <section class="article-body" set:html={html}></section>
      </div>
      <a class="back-link" href="/blog">← Back to reviews</a>
    </main>
  </body>
</html>
