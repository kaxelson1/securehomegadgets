# SecureHomeGadgets Environment Configuration
# Copy this to .env and fill in your actual values

# =======================
# OpenAI API (Required)
# =======================
OPENAI_API_KEY=sk-proj-your-key-here

# =======================
# Website Configuration
# =======================
SITE_URL=https://securehomegadgets.com
SITE_NAME=Secure Home Gadgets

# =======================
# YouTube Configuration
# =======================
YOUTUBE_CHANNEL=@securehomegadgets
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# =======================
# Affiliate Programs
# =======================
# Amazon Associates
AMAZON_ASSOCIATE_ID=your-associate-tag

# Best Buy Affiliate Program
BESTBUY_AFFILIATE_ID=

# =======================
# Video Generation (Optional)
# =======================
# Choose one for YouTube Shorts generation:
# SYNTHESIA_API_KEY=
# HEYKEN_API_KEY=
# RUNWAY_API_KEY=

# =======================
# Email Notifications (Optional)
# =======================
# MAILCHIMP_API_KEY=
# MAILCHIMP_LIST_ID=
# SENDGRID_API_KEY=

# =======================
# Analytics (Optional)
# =======================
# GOOGLE_ANALYTICS_ID=
# HOTJAR_ID=

# =======================
# GitHub Actions (for CI/CD)
# =======================
# Add these as repository secrets in GitHub:
# - OPENAI_API_KEY
# - YOUTUBE_CHANNEL
# - AMAZON_ASSOCIATE_ID
